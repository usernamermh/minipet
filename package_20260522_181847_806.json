{
  "name": "qq-pet-desktop-companion",
  "version": "1.0.0",
  "description": "QQ宠物 - 桌面伴侣：一个智能桌面宠物应用",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build:python": "pip install -r requirements.txt",
    "test": "jest",
    "lint": "eslint src/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "axios": "^1.6.0",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0",
    "concurrently": "^8.2.0",
    "rimraf": "^5.0.0",
    "@types/node": "^20.10.0"
  },
  "build": {
    "appId": "com.qqpet.desktop",
    "productName": "QQ宠物桌面伴侣",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "resources/**/*",
      "python/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}