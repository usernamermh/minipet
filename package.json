{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "A desktop pet application similar to QQ Pet",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:python\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "tsc -p tsconfig.renderer.json --watch",
    "dev:python": "cd src/python && python main.py",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "start": "node scripts/start-electron.cjs .",
    "package": "electron-builder",
    "postinstall": "echo skip"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "pet"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron": "28.3.3",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fastify": "^4.0.0"
  },
  "build": {
    "appId": "com.desktop.pet",
    "productName": "Desktop Pet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "resources/**/*",
      "config/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
